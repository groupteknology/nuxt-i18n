{
  "name": "@groupteknology/nuxt-i18n",
  "version": "0.0.1",
  "description": "Lightweight typed i18n module for Nuxt",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "i18n",
    "internationalization",
    "localization",
    "typescript"
  ],
  "homepage": "https://github.com/groupteknology/nuxt-i18n#readme",
  "bugs": {
    "url": "https://github.com/groupteknology/nuxt-i18n/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/groupteknology/nuxt-i18n.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write",
    "prepack": "nuxt-module-build build",
    "release": "npm run lint && npm run test && npm run test:types && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "test": "vitest run",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "resolutions": {
    "@groupteknology/nuxt-i18n": "workspace:*"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.2",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@nuxt/test-utils": "^4.0.1",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.2.0",
    "eslint-plugin-perfectionist": "^5.8.0",
    "nuxt": "^4.4.2",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.3",
    "vue-tsc": "^3.2.6"
  },
  "peerDependencies": {
    "nuxt": "^4.4.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
